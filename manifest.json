{
  "manifest_version": 3,
  "name": "Eyes Only",
  "description": "Navigate the web with your eyes. Gaze moves the cursor, blink to click.",
  "version": "0.1.0",
  "permissions": ["offscreen"],
  "action": {
    "default_title": "Eyes Only - Eye Tracking Navigation",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
